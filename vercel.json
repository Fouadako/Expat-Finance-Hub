{
  "buildCommand": "pnpm --filter @workspace/ike-ikze run build",
  "outputDirectory": "artifacts/ike-ikze/dist/public",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "artifacts/api-server/guides/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
